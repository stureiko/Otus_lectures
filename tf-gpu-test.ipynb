   "source": [
    "# Check if TensorFlow can access a GPU\n",
    "gpu_available = tf.config.list_physical_devices('GPU')\n",
    "\n",
    "if gpu_available:\n",
    "    print(\"GPU is available:\")\n",
    "    for gpu in gpu_available:\n",
    "        print(gpu)\n",
    "else:\n",
    "    print(\"No GPU available.\")"
   ]
